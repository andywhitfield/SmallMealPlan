@model SmallMealPlan.Web.Model.Home.IndexCalendarViewModel
@section HeaderScripts {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@7.1.3/skeleton.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@7.1.3/themes/classic/theme.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@7.1.3/themes/classic/palette.css" />
}
@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@7.1.3/all/global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@7.1.3/themes/classic/global.js"></script>
<script type="text/javascript">
$().ready(function() {
    $('#smp-event-details-dialog-close').click(function() {
        $('#smp-event-details-dialog')[0].close();
    });

    const datesLoaded = new Set();
    const darkMode = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
    $('body').attr('data-color-scheme', darkMode && darkMode.matches ? 'dark' : 'light');
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', event => {
        $('body').attr('data-color-scheme', event.matches ? 'dark' : 'light');
    });
    var calendar = new FullCalendar.Calendar(document.getElementById('calendar'), {
        initialView: 'dayGridMonth',
        initialDate: '@Model.InitialDate',
        firstDay: 1,
        headerToolbar: false,
        eventStartEditable: true,
        eventDrop: function(info) {
            console.log('moving meal ' + info.event.id + ' to date ' + info.event.start.toISOString().slice(0, 10).replace(/-/g,''));
            $.ajax({
                url: '/api/planner/' + info.event.id + '/move',
                type: 'PUT',
                data: JSON.stringify({ date: info.event.start.toISOString().slice(0, 10).replace(/-/g,'') }),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json'
            });
        },
        dateClick: function(info) {
            console.log('date clicked ' + info.dateStr);
            window.location = '/planner/'+info.dateStr.replace(/-/g,'')+'/add';
        },
        eventClick: function(info) {
            console.log('meal clicked ' + info.event.id);

            var templateContent = $('#smp-event-template').clone();
            templateContent.prop('id', self.crypto.randomUUID());
            var template = document.importNode(templateContent[0].content, true);
            var templateJQ = $(template);
            $('div', templateJQ).css('display', 'block');
            $('[data-id="date"]', templateJQ).text(info.event.extendedProps.record.dateDesc);
            $('[data-id="date"]', templateJQ).prop('href', '/planner/'+info.event.extendedProps.record.date.replace(/-/g,'')+'/edit/'+info.event.extendedProps.record.id);
            $('[data-id="title"]', templateJQ).text(info.event.extendedProps.record.title);

            let ingredientList = $('[data-id="ingredients"]', templateJQ);
            if (info.event.extendedProps.record.ingredients.length !== 0) {
                info.event.extendedProps.record.ingredients.forEach(function(ingredient) {
                    ingredientList.append($("<li>").text(ingredient));
                });
            } else {
                ingredientList.hide();
                ingredientList.prev().hide();
            }

            let notes = $('[data-id="notes"]', templateJQ);
            if (info.event.extendedProps.record.notes) {
                notes.text(info.event.extendedProps.record.notes);
            } else {
                notes.hide();
                notes.prev().hide();
            }

            let dateNotes = $('[data-id="date-notes"]', templateJQ);
            if (info.event.extendedProps.record.dateNotes) {
                dateNotes.prev().text('Notes for '+info.event.extendedProps.record.dateDesc+':');
                dateNotes.text(info.event.extendedProps.record.dateNotes);
            } else {
                dateNotes.hide();
                dateNotes.prev().hide();
            }

            var dialogDetails = $('#smp-event-details');
            dialogDetails.empty();
            dialogDetails.append(templateJQ);
            $('#smp-event-details-dialog')[0].showModal();
        },
        eventContent: function(event) {
            return { html: '<span class="smp-cal-title">' + event.event.title + '</span>' };
        }
    });
    calendar.render();
    function onDateChange() {
        $('#calendar-date').text(calendar.getDate().toLocaleDateString(undefined, { year: 'numeric', month: 'long' }));
        $('#calendar-date').click(function() { window.location.href = '/planner/'+calendar.getDate().toISOString().slice(0, 10).replace(/-/g,'')+'?view=list'; });
        const calendarMonth = new Date(Date.UTC(calendar.getDate().getFullYear(), calendar.getDate().getMonth(), 1));
        if (datesLoaded.has(calendarMonth.getTime())) {
            console.log('meals already loaded for date ' + calendarMonth + ', no need to load meals');
        } else {
            console.log('meals not loaded for date ' + calendarMonth + ', loading...');
            $.getJSON('/api/calendar/meals/'+encodeURIComponent(calendarMonth.toISOString()))
                .done(function(data) {
                    console.log('meals retrieved...adding to calendar');
                    data.forEach(function(mealEntry) {
                        if (!calendar.getEventById(mealEntry.id))
                            calendar.addEvent({ id: mealEntry.id, title: '' + mealEntry.title, start: mealEntry.date, allDay: true, extendedProps: { record: mealEntry } });
                        else
                            console.log('event ' + mealEntry.id + ' already in calendar, not adding again');
                    });
                    console.log('added '+data.length+' meals to calendar');
                    datesLoaded.add(calendarMonth.getTime());
                })
                .fail(function() {
                    console.warn('failed getting meals');
                });
        }
    }

    onDateChange();    
    $('#cal-today').click(function() { calendar.today(); onDateChange(); });
    $('#cal-prev-year').click(function() { calendar.prevYear(); onDateChange(); });
    $('#cal-prev-month').click(function() { calendar.prev(); onDateChange(); });
    $('#cal-next-year').click(function() { calendar.nextYear(); onDateChange(); });
    $('#cal-next-month').click(function() { calendar.next(); onDateChange(); });
});
</script>
}

<div class="smp-calendar-date"><button id="calendar-date" title="View as a list"></button></div>
<div class="smp-cal-date-controls">
<button id="cal-prev-year" title="Previous year">&nbsp;&laquo;&nbsp;</button>
<button id="cal-prev-month" title="Previous month">&nbsp;&nbsp;&lsaquo;&nbsp;&nbsp;</button>
<button id="cal-today" title="Go to the current month">Today</button>
<button id="cal-next-month" title="Next month">&nbsp;&nbsp;&rsaquo;&nbsp;&nbsp;</button>
<button id="cal-next-year" title="Next year">&nbsp;&raquo;&nbsp;</button>
</div>
<div id="calendar"></div>

<dialog id="smp-event-details-dialog">
    <div id="smp-event-details"></div>
    <button id="smp-event-details-dialog-close">Close</button>
</dialog>

<template id="smp-event-template">
    <div><a href="#" data-id="date"></a></div>

    <div data-id="title"></div>
    <div class="smp-planner-list-meal-details">
        <div>Ingredients:</div>
        <ul data-id="ingredients"></ul>

        <div class="smp-meal-notes">Notes:</div>
        <div data-id="notes"></div>

        <div class="smp-meal-notes"></div>
        <div data-id="date-notes"></div>
    </div>
</template>