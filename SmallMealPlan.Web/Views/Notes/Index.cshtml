@model SmallMealPlan.Web.Model.Notes.IndexViewModel
@{bool anyNotes = false;}
<form action="/notes/sort" method="post">
@Html.AntiForgeryToken()
<button type="button" title="Add a new note" onclick="window.location.href='/notes/add'">Add</button>
<button type="button" title="Sort by the most recently added or changed note to the oldest" id="smp-note-sort" data-visible="@(Model.SortedManually ? "true" : "")">Sort by latest</button>
</form>

<!-- TODO: add find -->

<ul class="smp-planner-list">
    <li class="smp-planner-list">
        <ul class="smp-planner-list-meal">
            @await foreach (var note in Model.Notes) {
            anyNotes = true;
            <li class="smp-planner-list-meal" data-note="@note.Note.NoteId">
                <div><img class="smp-planner-list-meal-drag-handle" src="/images/drag.png" height="26" width="22" title="Move" /></div>
                <div></div>
                <div>@note.TitleForDisplay</div>
                <div>
                    <form method="get" action="/notes/@note.Note.NoteId">
                    <button title="Bought"><img src="/images/notes.png" height="15" width="15" /> Edit</button>
                    </form>
                    <form data-confirm="Are you sure you want to delete this note?" method="post" action="/notes/delete/@note.Note.NoteId">
                    @Html.AntiForgeryToken()
                    <button title="Delete"><img src="/images/close.png" height="15" width="15" /> Delete</button>
                    </form>
                </div>
            </li>
            }
            @if (!anyNotes) {
            <div>You don't currently have any notes. <button type="button" title="Add a new note" onclick="window.location.href='/notes/add'">Add a new note</button></div>
            }
        </ul>
    </li>
</ul>
